<?xml version="1.0"?>
<!-- Alpha 2 in Gazebo Sim (Harmonic). Run:  export GZ_SIM_RESOURCE_PATH=<parent of alpha2_description>;  gz sim -r gazebo/alpha2_world.sdf
     Joint targets: gz topic -t /model/alpha2/joint/<joint>/0/cmd_pos -m gz.msgs.Double -p "data: 0.3"  (topic names: see gz topic -l)
     NOT simulated here (no Gazebo runtime); only parsed with libsdformat 14. Controller gains = the MuJoCo test values (kp 20, kv 0.5, torque limit = servo stall torque). -->
<sdf version="1.11">
  <world name="alpha2_world">
    <physics name="1ms" type="dart"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link></model>
    <include>
      <uri>model://alpha2_description</uri>
      <name>alpha2</name>
      <pose>0 0 0.2206 0 0 0</pose>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_shoulder_pitch_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_shoulder_roll_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_elbow_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_shoulder_pitch_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_shoulder_roll_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_elbow_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_hip_roll_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_hip_pitch_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_knee_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_ankle_pitch_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_ankle_roll_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_hip_roll_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_hip_pitch_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_knee_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_ankle_pitch_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_ankle_roll_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.9613</cmd_max><cmd_min>-1.9613</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>r_hand_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>l_hand_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>head_yaw_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>head_pitch_joint</joint_name><p_gain>20.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><cmd_max>1.1768</cmd_max><cmd_min>-1.1768</cmd_min>
      </plugin>
    </include>
  </world>
</sdf>
