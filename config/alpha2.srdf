<?xml version="1.0"?>
<robot name="alpha2">
  <group name="right_arm">
    <chain base_link="base_link" tip_link="r_hand_link" />
  </group>
  <group name="left_arm">
    <chain base_link="base_link" tip_link="l_hand_link" />
  </group>
  <group name="right_leg">
    <chain base_link="base_link" tip_link="r_ankle_roll_link" />
