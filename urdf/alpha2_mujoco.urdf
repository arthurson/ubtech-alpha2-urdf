<?xml version="1.0"?>
<!-- MASS MODEL: total 2.3 kg = 20 servos (IDs 2,3,5,6,17-20: 40.3 g, 12 kg*cm; IDs 1,4,7-16: 52.8 g, 20 kg*cm; modelled as point masses at each joint pivot, in the child link) + 3x18650 cells (50 g, upright, rear of body, assumed position) + remaining mass (shell, mainboards, wiring) distributed by convex-hull volume. -->
<!-- COLLISION: each link uses a convex decomposition (CoACD, up to 8 convex pieces per link, from the visual mesh) instead of a single convex hull. -->
<!-- Alpha 2 (UBTech) humanoid. Generated from alpha2_21parts OBJ meshes + Alpha2_PC_Programming alpha2.FBX/alpha2.xml.
     Frame: ROS REP-103 (x forward, y left, z up), SI units. Zero pose = standing pose of the PC-software model (arms down).
     Every link frame is axis-aligned with base_link at q=0 and sits on its servo pivot. Inertials are ESTIMATES (see README). -->
<robot name="alpha2">
  <!-- MuJoCo physics copy of alpha2.urdf: visual geometry, frame links (camera/accel/sole/tips) and base_footprint removed; collision pieces only. Joint limits, axes, masses and inertias are identical. -->
  <mujoco><compiler meshdir=".." discardvisual="true" fusestatic="false" balanceinertia="false"/></mujoco>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00709738 6.18141e-05 0.0538055" rpy="0 0 0"/>
      <mass value="0.41816"/>
      <inertia ixx="5.9534e-04" ixy="-7.6981e-07" ixz="4.9203e-05" iyy="5.4347e-04" iyz="-2.4015e-07" izz="4.7651e-04"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/base_link_0.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/base_link_1.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/base_link_2.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/base_link_3.stl"/></geometry>
    </collision>
    <collision>
