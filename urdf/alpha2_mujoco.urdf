    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/base_link_5.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/base_link_6.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/base_link_7.stl"/></geometry>
    </collision>
  </link>
  <link name="r_shoulder_pitch_link">
    <inertial>
      <origin xyz="-7.69907e-05 0.00134078 -5.81484e-05" rpy="0 0 0"/>
      <mass value="0.06486"/>
      <inertia ixx="2.6789e-06" ixy="2.4358e-09" ixz="-2.0112e-09" iyy="2.0496e-06" iyz="5.7640e-09" izz="3.2987e-06"/>
    </inertial>
