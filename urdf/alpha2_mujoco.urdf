      <geometry><mesh filename="meshes/collision/head_pitch_link_5.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/head_pitch_link_6.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/head_pitch_link_7.stl"/></geometry>
    </collision>
  </link>
  <!-- servo 20 (頭上下); PC-software node "head1"; InitAngle=120, Offset=-135 ; URDF zero overridden: q = servo - 120 (user: servo 19/20 at 120 = level) -->
  <joint name="head_pitch_joint" type="revolute">
    <parent link="head_yaw_link"/>
    <child link="head_pitch_link"/>
    <origin xyz="-0.00621756 3.48091e-08 -0.000771606" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.26180" upper="0.61087" effort="1.1768" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Reference frames (no mass, no geometry). Sole frames: centre of the sole plane of each foot (from the full-resolution visual mesh); hand tips: lowest point of the hand link at the zero pose. -->
  <!-- base_footprint: point on the ground below base_link in the PC-software default stance (servo = InitAngle, legs slightly bent); height = lowest point of the visual meshes. In the zero pose (straight legs) the feet sit 2 mm above this ground. -->

  <!-- Camera: the small circle on the front face of the head (lens centre). camera_link: x forward, y left, z up. camera_optical_frame: REP-103 optical (z forward, x right, y down). Intrinsics unknown. -->

  <!-- Accelerometer on the head mainboard, lying flat (axes aligned with the head frame: x fwd, y left, z up). Position ASSUMED = head link centre of mass. No IMU/gyro on this robot. -->
</robot>
