  <link name="head_yaw_link">
    <inertial>
      <origin xyz="-4.91445e-10 -2.05835e-05 8.56684e-10" rpy="0 0 0"/>
      <mass value="0.05101"/>
      <inertia ixx="1.7620e-06" ixy="3.3881e-13" ixz="3.4680e-13" iyy="1.7562e-06" iyz="-3.6046e-13" izz="1.7620e-06"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/head_yaw_link_0.stl"/></geometry>
    </collision>
  </link>
  <!-- servo 19 (頭左右); PC-software node "head2"; InitAngle=120, Offset=-120 -->
  <joint name="head_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="head_yaw_link"/>
    <origin xyz="0.0100771 0.00165642 0.115073" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.78540" upper="0.78540" effort="1.1768" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <link name="head_pitch_link">
    <inertial>
      <origin xyz="0.0014249 -0.00165684 0.0379125" rpy="0 0 0"/>
      <mass value="0.26086"/>
      <inertia ixx="3.6421e-04" ixy="2.4026e-06" ixz="2.6554e-06" iyy="3.5084e-04" iyz="-1.4847e-05" izz="2.6399e-04"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/head_pitch_link_0.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/head_pitch_link_1.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/head_pitch_link_2.stl"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/head_pitch_link_4.stl"/></geometry>
    </collision>
    <collision>
